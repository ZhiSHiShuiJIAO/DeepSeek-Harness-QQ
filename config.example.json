  "sticker": {
    "enabled": true,
    "dir": "_sticker"
  },
  "sing": {
    "enabled": true,
    "dir": "sandbox/sing",
    "timeout_sec": 600
  },
  "proactive": {
    "enabled": true,
    "idle_minutes": 28,
    "jitter": [
      0.75,
      2.0
    ],
    "cooldown_minutes": 15,
    "max_per_day": 5,
    "quiet_hours": [
      23,
      8
    ],
    "check_interval_sec": 90,
    "prompt": null
