    "gsv_timeout_sec": 240,
    "ref_audio": "",
    "prompt_text": "",
    "tune": {
      "top_k": 8,
      "temperature": 0.9,
      "text_split_method": "cut0",
      "speed_factor": 1.18,
      "pitch": 0.0
